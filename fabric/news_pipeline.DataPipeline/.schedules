{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/gitIntegration/schedules/1.0.0/schema.json",
  "schedules": [
    {
      "enabled": true,
      "enabledControlType": "UserEnabled",
      "jobType": "Execute",
      "configuration": {
        "type": "Cron",
        "startDateTime": "2026-10-09T21:05:00",
        "endDateTime": "9999-12-31T23:59:00",
        "localTimeZoneId": "SE Asia Standard Time",
        "interval": 60
      }
    }
  ]
}